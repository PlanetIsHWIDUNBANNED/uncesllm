{
  "name": "My Linux PC",

  "image": "mcr.microsoft.com/devcontainers/base:jammy",

  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1.2.10": {
      "password": "vscode",
      "webPort": "6080",
      "vncPort": "5901"
    }
  },

  "forwardPorts": [
    6080
  ],

  "portsAttributes": {
    "6080": {
      "label": "Linux Desktop"
    }
  },

  "runArgs": [
    "--init",
    "--shm-size=1g"
  ]
}